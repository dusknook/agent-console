    "/v1/state/change_requests/{id}/approve": {
      "post": {
        "operationId": "POST_v1_state_change_requests_id_approve",
        "tags": [
          "状态 STATE"
        ],
        "summary": "人类批准变更：旧记录标 superseded、新记录链上 previous_id（不是原地改写不可变记录）。批准后 requires 从 human 降回 auto。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "REQUIRE_APPROVAL —— 被网关截停，请求已原样落盘为审批单，业务代码一行未执行"
          },
          "default": {
            "description": "统一信封。业务错误码在 error.code 里，不在这份声明里 —— 声明不出来的东西就不写，免得 spec 撒谎。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "x-requires": [
          "human"
        ],
        "x-idempotency": "fingerprint_dedup",
        "x-gate": {
          "level": "approval",
          "why": "批准变更 = 改写已锁定的决策 / 资产",
          "agent_behaviour": "403 REQUIRE_APPROVAL，请求挂起；重试不会让它执行，只会白烧上下文",
          "execution_entry": "/v1/approvals/{id}/decide（批准时由服务端回放本请求）"
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "by": "user"
              }
            }
          }
        }
      }
    },
